{
  "fontFamily": {
    "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Helvetica, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", SimSun, sans-serif",
    "mono": "Consolas, \"Liberation Mono\", \"Courier New\", monospace"
  },
  "fontWeight": {
    "regular": "400",
    "medium": "500"
  },
  "styles": {
    "h1": {
      "fontSize": "30px",
      "lineHeight": "38px",
      "fontWeight": "{typography.fontWeight.regular}"
    },
    "h2": {
      "fontSize": "24px",
      "lineHeight": "32px",
      "fontWeight": "{typography.fontWeight.regular}"
    },
    "h3": {
      "fontSize": "20px",
      "lineHeight": "28px",
      "fontWeight": "{typography.fontWeight.regular}"
    },
    "title": {
      "fontSize": "18px",
      "lineHeight": "26px",
      "fontWeight": "{typography.fontWeight.regular}"
    },
    "subtitle": {
      "fontSize": "16px",
      "lineHeight": "24px",
      "fontWeight": "{typography.fontWeight.regular}"
    },
    "body": {
      "fontSize": "14px",
      "lineHeight": "22px",
      "fontWeight": "{typography.fontWeight.regular}"
    },
    "caption": {
      "fontSize": "12px",
      "lineHeight": "18px",
      "fontWeight": "{typography.fontWeight.regular}"
    }
  }
}
