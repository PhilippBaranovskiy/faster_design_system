{
  "name": "@faster-ui/react",
  "version": "0.1.0",
  "description": "Accessible React components for the Faster design system.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/style.css",
    "dist/components",
    "dist/tokens",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "storybook": "storybook dev -p 6006",
    "clean": "rm -rf dist",
    "build:tokens": "node scripts/generate-css-variables.mjs",
    "check:tokens": "node scripts/generate-css-variables.mjs --check",
    "build:types": "tsc -p tsconfig.build.json",
    "build:library": "vite build --config vite.library.config.ts",
    "build:pages": "vite build",
    "build:storybook": "storybook build -o dist/storybook",
    "build:production": "npm run clean && npm run build:tokens && npm run build:types && npm run build:library && npm run build:pages",
    "build": "npm run build:production && npm run build:storybook",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "typecheck:component": "tsc -p tsconfig.cypress.json --noEmit",
    "test": "npm run check:tokens && npm run lint && npm run format:check && npm run typecheck && npm run typecheck:component && npm run test:unit && npm run test:component",
    "test:unit": "jest --runInBand",
    "test:unit:watch": "jest --watch",
    "test:component": "cypress run --component --browser electron",
    "test:component:open": "cypress open --component",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run check:tokens && npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cypress": "^15.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jest": "^30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "storybook": "^10.5.9",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
